# RAG 伺服器設定
RAG_SERVER_URL=http://localhost:8000
RAG_SERVER_TIMEOUT=30

# LLM 設定
LLM_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# API 服務設定
API_HOST=0.0.0.0
API_PORT=8001
API_RELOAD=true

# RAG 搜尋預設值
RAG_COLLECTION=embedding-seperate
RAG_MODE=hybrid
RAG_LIMIT=10
RAG_SCORE_THRESHOLD=1
