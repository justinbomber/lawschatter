{
  "case_type": "judgment_analysis",
  "case_name": "判決書分析",
  "description": "判決書結構化分析配置",
  "schema_file": "judgment_analysis_schema.md",
  "json_schema": {
    "$schema": "https://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "defendants": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "defendant_name": {
              "type": "string",
              "description": "被告姓名"
            },
            "has_defense_attorney": {
              "type": "boolean",
              "description": "被告是否有選任辯護人"
            },
            "defense_attorney_name": {
              "type": "string",
              "description": "辯護人名稱（若 has_defense_attorney 為 true 時填寫，否則填空字串）"
            },
            "prosecution_articles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "本件遭起訴之法條（有幾條填幾條）"
            },
            "indictment_changed": {
              "type": "boolean",
              "description": "檢察官是否變更起訴法條（若同一條文但項次不同，仍視為變更）"
            },
            "original_indictment_articles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "原本起訴法條（若 indictment_changed 為 true 時填寫，有幾條填幾條）"
            },
            "changed_indictment_articles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "變更起訴法條（若 indictment_changed 為 true 時填寫，有幾條填幾條）"
            },
            "has_new_old_law_issue": {
              "type": "boolean",
              "description": "本件是否有新舊法適用的問題"
            },
            "new_old_law_disputed_article": {
              "type": "string",
              "description": "新舊法爭議的法條（若 has_new_old_law_issue 為 true 時填寫）"
            },
            "has_contradictory_statements": {
              "type": "boolean",
              "description": "是否有審理中與偵查中就核心事實或主要辯解內容出現矛盾、否認、或重大變更之陳述"
            },
            "confession_status": {
              "type": "string",
              "enum": [
                "完全認罪",
                "完全否認",
                "部分"
              ],
              "description": "是否在本次審理中認罪"
            },
            "is_full_acquittal": {
              "type": "boolean",
              "description": "本件是否為全部無罪判決"
            },
            "is_acquittal_due_to_insufficient_evidence": {
              "type": "boolean",
              "description": "是否因為罪證不足而獲得全部無罪判決（若 is_full_acquittal 為 true 時填寫）"
            },
            "is_other_verdict": {
              "type": "boolean",
              "description": "本件是否為無罪、有罪以外的判決結果"
            },
            "is_conviction": {
              "type": "boolean",
              "description": "本件是否為有罪判決"
            },
            "crime_list": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "本次罪名清單（若 is_conviction 為 true 時填寫，例如：「三人以上共同詐欺取財罪」、「洗錢未遂罪」，關鍵字是 XXX 罪）"
            },
            "violated_law_articles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "所違反的法律條文（若 is_conviction 為 true 時填寫，列出具體法條與條次，關鍵字 XXX 條 XXX 項）"
            },
            "is_conviction_same_as_prosecution": {
              "type": "boolean",
              "description": "本件判決法院認定有罪適用法條的部分，是否與遭起訴的部分完全相同（若 is_conviction 為 true 時填寫）"
            },
            "conviction_prosecution_difference_articles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "若判決法條與起訴法條不同，請僅列出差異的法條名稱與條號（若 is_conviction_same_as_prosecution 為 false 時填寫）"
            },
            "is_fixed_term_imprisonment": {
              "type": "boolean",
              "description": "本件是否為有期徒刑"
            },
            "fixed_term_years": {
              "type": "integer",
              "description": "有期徒刑年數（若 is_fixed_term_imprisonment 為 true 時填寫，否則填 0）"
            },
            "fixed_term_months": {
              "type": "integer",
              "description": "有期徒刑月數（若 is_fixed_term_imprisonment 為 true 時填寫，否則填 0）"
            },
            "is_life_imprisonment": {
              "type": "boolean",
              "description": "本件是否為無期徒刑"
            },
            "is_death_penalty": {
              "type": "boolean",
              "description": "本件是否為死刑"
            },
            "is_detention": {
              "type": "boolean",
              "description": "本件是否為拘役"
            },
            "detention_days": {
              "type": "integer",
              "description": "拘役天數（若 is_detention 為 true 時填寫，否則填 0）"
            },
            "has_concurrent_fine": {
              "type": "boolean",
              "description": "本件是否併科罰金"
            },
            "fine_amount": {
              "type": "integer",
              "description": "罰金金額（新臺幣，若 has_concurrent_fine 為 true 時填寫，否則填 0）"
            },
            "may_convert_to_fine": {
              "type": "boolean",
              "description": "本件是否得易科罰金（易科罰金不需要折算率）"
            },
            "has_probation": {
              "type": "boolean",
              "description": "本件是否給予緩刑"
            },
            "probation_period": {
              "type": "string",
              "description": "給予緩刑之期間（若 has_probation 為 true 時填寫，例如：「2年」、「3年6月」）"
            },
            "has_mitigation_articles": {
              "type": "boolean",
              "description": "本件是否有適用減刑的條文"
            },
            "mitigation_articles": {
              "type": "string",
              "description": "適用減刑的條文為（若 has_mitigation_articles 為 true 時填寫）"
            },
            "has_settlement": {
              "type": "boolean",
              "description": "本件是否與被害人或告訴人和解"
            },
            "is_full_settlement": {
              "type": "boolean",
              "description": "是否與全部被害人或告訴人和解（若 has_settlement 為 true 時填寫）"
            },
            "settlement_amount": {
              "type": "integer",
              "description": "和解之總金額（新臺幣，若 has_settlement 為 true 時填寫，否則填 0）"
            },
            "is_settlement_fulfilled": {
              "type": "boolean",
              "description": "法院是否認定和解已經履行（若 has_settlement 為 true 時填寫）"
            },
            "is_settlement_installment": {
              "type": "boolean",
              "description": "本件和解是否分期（若 has_settlement 為 true 時填寫）"
            },
            "has_witnesses": {
              "type": "boolean",
              "description": "本件是否有證人（被告以外之人，包含共同被告）"
            },
            "witness_testified_in_investigation": {
              "type": "boolean",
              "description": "證人是否有在偵查中作證（若 has_witnesses 為 true 時填寫）"
            },
            "witness_testified_in_trial": {
              "type": "boolean",
              "description": "證人是否有在審判中作證（若 has_witnesses 為 true 時填寫）"
            },
            "has_seized_items": {
              "type": "boolean",
              "description": "本件是否有遭扣押物品"
            },
            "seized_items": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "本件遭扣押物品（若 has_seized_items 為 true 時填寫）"
            },
            "has_confiscated_items": {
              "type": "boolean",
              "description": "本件是否遭沒收物品"
            },
            "confiscated_items": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "本件遭沒收物品（若 has_confiscated_items 為 true 時填寫）"
            },
            "has_surrendered_proceeds": {
              "type": "boolean",
              "description": "本件是否繳交犯罪所得"
            },
            "is_first_instance": {
              "type": "boolean",
              "description": "是否為一審判決"
            },
            "is_second_instance": {
              "type": "boolean",
              "description": "是否為二審判決"
            },
            "is_third_instance": {
              "type": "boolean",
              "description": "是否為三審判決"
            },
            "has_previous_instance": {
              "type": "boolean",
              "description": "是否有原審（前審）判決（是否為上訴案件）"
            },
            "is_reversed_and_remanded": {
              "type": "boolean",
              "description": "是否撤銷改判（若 has_previous_instance 為 true 時填寫）"
            },
            "is_sentence_reduced": {
              "type": "boolean",
              "description": "是否減輕量刑（若 is_reversed_and_remanded 為 true 時填寫）"
            },
            "is_sentence_increased": {
              "type": "boolean",
              "description": "是否加重量刑（若 is_reversed_and_remanded 為 true 時填寫）"
            },
            "is_law_article_changed_from_previous": {
              "type": "boolean",
              "description": "是否變更原審（前審）適用法條（若 has_previous_instance 為 true 時填寫）"
            },
            "changed_law_articles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "變更法條為（若 is_law_article_changed_from_previous 為 true 時填寫，有幾條填幾條）"
            },
            "previous_instance_confession_status": {
              "type": "string",
              "enum": [
                "完全認罪",
                "完全否認",
                "部分",
                "不適用"
              ],
              "description": "原審（前審）是否有認罪（若 has_previous_instance 為 true 時填寫）"
            },
            "current_instance_confession_status": {
              "type": "string",
              "enum": [
                "完全認罪",
                "完全否認",
                "部分",
                "不適用"
              ],
              "description": "本件（上訴案件）是否有認罪（若 has_previous_instance 為 true 時填寫）"
            },
            "has_inconsistent_statements_with_previous": {
              "type": "boolean",
              "description": "是否有與原審答辯或主要陳述內容不一致之情形（若 has_previous_instance 為 true 時填寫）"
            },
            "statement_difference_description": {
              "type": "string",
              "description": "若有，請以一句話描述前後陳述的主要差異（若 has_inconsistent_statements_with_previous 為 true 時填寫）"
            },
            "has_justification_issue": {
              "type": "boolean",
              "description": "本件是否有阻卻違法的爭點"
            },
            "has_justification_applied": {
              "type": "boolean",
              "description": "本件是否有阻卻違法的適用（若 has_justification_issue 為 true 時填寫）"
            },
            "has_excuse_issue": {
              "type": "boolean",
              "description": "本件是否有阻卻罪責的爭點"
            },
            "has_excuse_applied": {
              "type": "boolean",
              "description": "本件是否有阻卻罪責的適用（若 has_excuse_issue 為 true 時填寫）"
            },
            "has_attempt_issue": {
              "type": "boolean",
              "description": "本件是否有未遂的爭點"
            },
            "attempt_related_articles": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "本件涉及未遂行為的法條（若 has_attempt_issue 為 true 時填寫）"
            },
            "has_act_count_issue": {
              "type": "boolean",
              "description": "本件是否有行為數的爭點"
            },
            "act_count_issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "article": {
                    "type": "string",
                    "description": "行為數爭點所涉及法條"
                  },
                  "act_classification": {
                    "type": "string",
                    "enum": [
                      "單一行為",
                      "接續犯",
                      "集合犯",
                      "吸收犯",
                      "結合犯",
                      "其他",
                      "實質競合"
                    ],
                    "description": "犯罪行為數性質或是行為分類"
                  },
                  "classification_reason": {
                    "type": "string",
                    "description": "上述分類理由"
                  },
                  "multiple_acts_recognized": {
                    "type": "boolean",
                    "description": "判決認定為數個行為"
                  },
                  "has_similar_repeated_acts": {
                    "type": "boolean",
                    "description": "本件是否有相類似的重複行為"
                  },
                  "involves_multiple_victims": {
                    "type": "boolean",
                    "description": "是否涉及多名被害人"
                  }
                },
                "required": [
                  "article",
                  "act_classification",
                  "classification_reason",
                  "multiple_acts_recognized",
                  "has_similar_repeated_acts",
                  "involves_multiple_victims"
                ],
                "additionalProperties": false
              },
              "description": "行為數爭點列表（若 has_act_count_issue 為 true 時填寫，按法條列舉）"
            },
            "has_concurrent_offense_issue": {
              "type": "boolean",
              "description": "本件有沒有「一行為同時違反數個法條」的爭點"
            },
            "concurrent_offense_articles": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "article": {
                    "type": "string",
                    "description": "爭點所涉犯的法條"
                  },
                  "competition_resolution": {
                    "type": "string",
                    "enum": [
                      "想像競合",
                      "法條競合",
                      "吸收",
                      "其他"
                    ],
                    "description": "判決處理法條競合的方法"
                  },
                  "final_conviction_article": {
                    "type": "string",
                    "description": "最終成立的法條罪名"
                  }
                },
                "required": [
                  "article",
                  "competition_resolution",
                  "final_conviction_article"
                ],
                "additionalProperties": false
              },
              "description": "法條競合爭點列表（若 has_concurrent_offense_issue 為 true 時填寫）"
            },
            "has_criminal_record": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "本件被告是否有犯罪前科？【重要判斷原則】：(1) 判決僅載「有法院前案紀錄表附卷為憑」或「有前案紀錄表可查」等語句，僅代表法院有調取該資料，並非有前科；(2) 必須判決中有明確敘明被告過去曾犯某罪、曾受某刑之宣告等具體前科內容，才能認定為有前科（填 true）；(3) 若判決完全無提及前科資訊，或僅提及調取前案紀錄表但未說明內容，則應填 null（不明）；(4) 僅在判決明確記載「無前科」或「素行良好」等語時，才填 false。"
            },
            "prior_criminal_record_details": {
              "type": [
                "string",
                "null"
              ],
              "description": "被告所犯之前科內容。【填寫原則】：(1) 若判決有明確敘明前科內容（如過去犯某罪、受某刑宣告），則填寫具體內容；(2) 若 has_criminal_record 為 null（不明）或判決僅提及「有前案紀錄表」但未說明具體內容，則此欄填 null；(3) 若 has_criminal_record 為 false（明確無前科），則填「無前科」。"
            },
            "is_recidivism_same_type": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "本件被告所犯之罪與前科紀錄是否為相關犯罪類型？【填寫原則】：(1) 必須在判決明確載明前科內容的情況下，才能判斷本件罪名與前科是否為相關類型；(2) 若 has_criminal_record 為 null（不明）或前科內容不明確，則此欄應填 null；(3) 相關犯罪類型指：同一罪章、同一法益、或犯罪手法相似之罪名。"
            },
            "has_specific_prior_record_mention": {
              "type": "boolean",
              "description": "本件判決是否有提到具體類型的前案紀錄？【判斷原則】：(1) 判決須有明確記載具體的前科罪名或犯罪類型（如「曾犯詐欺罪」「前因施用毒品遭判刑」等），才填 true；(2) 僅記載「有前案紀錄表附卷可稽」或類似語句，未說明具體罪名或類型者，應填 false；(3) 「具體類型」指有明確指出罪名、法條或犯罪類別。"
            }
          },
          "required": [
            "defendant_name",
            "has_defense_attorney",
            "defense_attorney_name",
            "prosecution_articles",
            "indictment_changed",
            "original_indictment_articles",
            "changed_indictment_articles",
            "has_new_old_law_issue",
            "new_old_law_disputed_article",
            "has_contradictory_statements",
            "confession_status",
            "is_full_acquittal",
            "is_acquittal_due_to_insufficient_evidence",
            "is_other_verdict",
            "is_conviction",
            "crime_list",
            "violated_law_articles",
            "is_conviction_same_as_prosecution",
            "conviction_prosecution_difference_articles",
            "is_fixed_term_imprisonment",
            "fixed_term_years",
            "fixed_term_months",
            "is_life_imprisonment",
            "is_death_penalty",
            "is_detention",
            "detention_days",
            "has_concurrent_fine",
            "fine_amount",
            "may_convert_to_fine",
            "has_probation",
            "probation_period",
            "has_mitigation_articles",
            "mitigation_articles",
            "has_settlement",
            "is_full_settlement",
            "settlement_amount",
            "is_settlement_fulfilled",
            "is_settlement_installment",
            "has_witnesses",
            "witness_testified_in_investigation",
            "witness_testified_in_trial",
            "has_seized_items",
            "seized_items",
            "has_confiscated_items",
            "confiscated_items",
            "has_surrendered_proceeds",
            "is_first_instance",
            "is_second_instance",
            "is_third_instance",
            "has_previous_instance",
            "is_reversed_and_remanded",
            "is_sentence_reduced",
            "is_sentence_increased",
            "is_law_article_changed_from_previous",
            "changed_law_articles",
            "previous_instance_confession_status",
            "current_instance_confession_status",
            "has_inconsistent_statements_with_previous",
            "statement_difference_description",
            "has_justification_issue",
            "has_justification_applied",
            "has_excuse_issue",
            "has_excuse_applied",
            "has_attempt_issue",
            "attempt_related_articles",
            "has_act_count_issue",
            "act_count_issues",
            "has_concurrent_offense_issue",
            "concurrent_offense_articles",
            "has_criminal_record",
            "prior_criminal_record_details",
            "is_recidivism_same_type",
            "has_specific_prior_record_mention"
          ],
          "additionalProperties": false
        }
      },
      "case_metadata": {
        "type": "object",
        "properties": {
          "first_instance": {
            "type": "boolean",
            "description": "是否為地方法院判決"
          },
          "second_instance": {
            "type": "boolean",
            "description": "是否為高等法院判決"
          },
          "third_instance": {
            "type": "boolean",
            "description": "是否為最高法院判決"
          },
          "case_type": {
            "type": "string",
            "enum": [
              "刑法",
              "民法",
              "行政法"
            ],
            "description": "案件類型，只能為：刑法，民法，行政法其中一種"
          },
          "jtitle_type": {
            "type": "string",
            "enum": [
              "詐欺",
              "毒品",
              "竊盜",
              "侵占",
              "妨害性自主",
              "傷害",
              "公共危險",
              "槍砲彈藥刀械",
              "偽造文書",
              "其他刑事",
              "債務給付類",
              "侵權行為／損害賠償類",
              "婚姻家庭類",
              "物權類",
              "公司／商事類",
              "勞資爭議類",
              "保險類",
              "其他民事"
            ],
